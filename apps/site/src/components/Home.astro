---
import { APP_URL, money, plans, rate } from "../config";
import { type Key, type Locale, tr } from "../i18n";
import Layout from "./Layout.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = tr(locale);
const order = ["discovery", "pro", "business", "terrain"];
const signup = `${APP_URL}/signup`;
---
<Layout locale={locale}>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-12 md:pt-24">
    <p class="mb-5 text-sm uppercase tracking-[0.2em] text-orange">{t("hero.kicker")}</p>
    <h1 class="max-w-4xl text-5xl leading-[1.05] md:text-7xl">{t("hero.title")}</h1>
    <p class="mt-6 max-w-2xl text-lg text-ink/75 md:text-xl">{t("hero.text")}</p>
    <div class="mt-9 flex flex-wrap items-center gap-5">
      <a href={signup} class="rounded-xl bg-orange px-7 py-4 text-lg font-medium text-white hover:bg-orange-dark">{t("hero.cta")}</a>
      <p class="text-sm text-grey">{t("hero.note", { n: new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-US").format(plans.plans.discovery.responses_per_month) })}</p>
    </div>
  </section>

  <section id="fonctionnement" class="bg-beige">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="mb-12 text-4xl md:text-5xl">{t("how.title")}</h2>
      <div class="grid gap-8 md:grid-cols-3">
        {[1, 2, 3].map((n) => (
          <div class="border-t border-ink/20 pt-6">
            <p class="serif text-5xl text-orange">{`0${n}`}</p>
            <h3 class="mb-2 mt-3 text-3xl">{t(`how.${n}.title` as Key)}</h3>
            <p class="text-ink/75">{t(`how.${n}.text` as Key)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-20">
    <h2 class="mb-10 max-w-2xl text-4xl md:text-5xl">{t("trust.title")}</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {[1, 2, 3].map((n) => <p class="rounded-2xl border border-sand bg-white p-6 text-lg">{t(`trust.${n}` as Key)}</p>)}
    </div>
  </section>

  <section id="tarifs" class="mx-auto max-w-6xl px-5 py-12">
    <h2 class="text-4xl md:text-5xl">{t("pricing.title")}</h2>
    <p class="mb-10 mt-3 max-w-3xl text-grey">{t("pricing.subtitle", { pct: plans.pioneer.discount_bps / 100, months: plans.pioneer.months, seats: plans.pioneer.seats })}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {order.map((code) => {
        const p = plans.plans[code];
        return (
          <div class={`rounded-2xl border bg-white p-6 ${code === "pro" ? "border-orange" : "border-sand"}`}>
            <h3 class="text-3xl">{t(`plan.${code}` as Key)}</h3>
            <p class="mt-3"><span class="serif text-3xl">{p.price_monthly ? money(p.price_monthly, locale) : t("pricing.free")}</span>{p.price_monthly ? <span class="ml-1 text-sm text-grey">{t("pricing.month")}</span> : null}</p>
            <ul class="mt-5 grid gap-2 text-[15px] text-ink/80">
              <li>{t("pricing.responses", { n: new Intl.NumberFormat(locale === "fr" ? "fr-FR" : "en-US").format(p.responses_per_month) })}</li>
              <li>{t("pricing.members", { n: p.members })}</li>
              <li>{t("pricing.fee", { rate: rate(p.fee_bps, locale) })}</li>
              <li>{t(`plan.${code}.text` as Key)}</li>
            </ul>
          </div>
        );
      })}
    </div>
    <p class="mt-5 text-grey"><span class="serif mr-2 text-xl text-ink">{t("plan.enterprise")}</span>{t("pricing.quote", { price: money(plans.plans.enterprise.price_monthly_from, locale) })}. {t("plan.enterprise.text")}.</p>
  </section>

  <section class="mx-auto mt-12 max-w-6xl px-5">
    <div class="rounded-3xl bg-ink px-8 py-16 text-center text-cream">
      <h2 class="mx-auto max-w-3xl text-4xl md:text-5xl">{t("cta.title")}</h2>
      <a href={signup} class="mt-8 inline-block rounded-xl bg-orange px-7 py-4 text-lg font-medium text-white hover:bg-orange-dark">{t("cta.button")}</a>
    </div>
  </section>
</Layout>
