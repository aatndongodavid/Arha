{
 "registration": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": false,
    "currency": "XAF",
    "feeBearer": "org",
    "provider": "fake"
   }
  },
  "variables": [],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "h1",
      "type": "heading",
      "content": {
       "fr": "Inscription",
       "en": "Inscription"
      }
     },
     {
      "id": "q_role",
      "type": "single_choice",
      "label": {
       "fr": "Role",
       "en": "Role"
      },
      "required": true,
      "options": [
       {
        "id": "parent",
        "label": {
         "fr": "parent",
         "en": "parent"
        },
        "code": 1
       },
       {
        "id": "student",
        "label": {
         "fr": "student",
         "en": "student"
        },
        "code": 2
       },
       {
        "id": "teacher",
        "label": {
         "fr": "teacher",
         "en": "teacher"
        },
        "code": 3
       }
      ]
     },
     {
      "id": "q_age",
      "type": "number",
      "label": {
       "fr": "Age",
       "en": "Age"
      },
      "validation": {
       "min": 0,
       "max": 120,
       "integer": true
      }
     },
     {
      "id": "q_guardian",
      "type": "short_text",
      "label": {
       "fr": "Tuteur",
       "en": "Tuteur"
      }
     }
    ]
   },
   {
    "id": "p2",
    "blocks": [
     {
      "id": "q_children",
      "type": "number",
      "label": {
       "fr": "Enfants",
       "en": "Enfants"
      },
      "validation": {
       "min": 1,
       "max": 20
      }
     },
     {
      "id": "q_email",
      "type": "email",
      "label": {
       "fr": "E-mail",
       "en": "E-mail"
      },
      "required": true
     }
    ]
   },
   {
    "id": "p3",
    "blocks": [
     {
      "id": "q_comment",
      "type": "long_text",
      "label": {
       "fr": "Commentaire",
       "en": "Commentaire"
      }
     }
    ]
   }
  ],
  "rules": [
   {
    "id": "r1",
    "when": {
     "all": [
      {
       "field": "q_role",
       "op": "eq",
       "value": "parent"
      },
      {
       "any": [
        {
         "field": "q_age",
         "op": "gte",
         "value": 18
        },
        {
         "field": "q_guardian",
         "op": "not_empty"
        }
       ]
      }
     ]
    },
    "then": [
     {
      "action": "show",
      "target": "q_children"
     },
     {
      "action": "require",
      "target": "q_children"
     }
    ]
   },
   {
    "id": "r2",
    "when": {
     "field": "q_role",
     "op": "eq",
     "value": "teacher"
    },
    "then": [
     {
      "action": "jump_to_page",
      "target": "p3"
     }
    ]
   }
  ]
 },
 "pricing": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": true,
    "currency": "XAF",
    "feeBearer": "org",
    "provider": "fake"
   }
  },
  "variables": [
   {
    "id": "total",
    "type": "number",
    "formula": {
     "op": "if",
     "args": [
      {
       "op": "gte",
       "args": [
        {
         "ref": "q_qty"
        },
        {
         "num": 10
        }
       ]
      },
      {
       "op": "mul",
       "args": [
        {
         "ref": "q_qty"
        },
        {
         "num": 4500
        }
       ]
      },
      {
       "op": "mul",
       "args": [
        {
         "ref": "q_qty"
        },
        {
         "num": 5000
        }
       ]
      }
     ]
    }
   }
  ],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "q_qty",
      "type": "number",
      "label": {
       "fr": "Quantite",
       "en": "Quantite"
      },
      "required": true,
      "validation": {
       "min": 1,
       "max": 1000,
       "integer": true
      }
     },
     {
      "id": "show_total",
      "type": "computed_display",
      "variable": "total"
     },
     {
      "id": "pay",
      "type": "payment_computed",
      "label": {
       "fr": "Paiement",
       "en": "Paiement"
      },
      "variable": "total"
     }
    ]
   }
  ],
  "rules": []
 },
 "products": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": true,
    "currency": "XAF",
    "feeBearer": "org",
    "provider": "fake"
   }
  },
  "variables": [],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "q_member",
      "type": "yes_no",
      "label": {
       "fr": "Membre",
       "en": "Membre"
      },
      "required": true
     },
     {
      "id": "q_items",
      "type": "product_choice",
      "label": {
       "fr": "Articles",
       "en": "Articles"
      },
      "options": [
       {
        "id": "tshirt",
        "label": {
         "fr": "tshirt",
         "en": "tshirt"
        },
        "code": 1,
        "price": 7500
       },
       {
        "id": "cap",
        "label": {
         "fr": "cap",
         "en": "cap"
        },
        "code": 2,
        "price": 3000
       }
      ]
     },
     {
      "id": "fee",
      "type": "payment_fixed",
      "label": {
       "fr": "Frais",
       "en": "Frais"
      },
      "amount": 2000
     }
    ]
   }
  ],
  "rules": [
   {
    "id": "r1",
    "when": {
     "field": "q_member",
     "op": "eq",
     "value": true
    },
    "then": [
     {
      "action": "hide",
      "target": "fee"
     }
    ]
   }
  ]
 },
 "ending": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": false,
