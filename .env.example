# Copy to apps/api/.env for local development. Never commit real values (rule 9).
ARHA_ENV=dev
ARHA_APP_URL=http://localhost:5173
ARHA_FORMS_URL=http://localhost:5174
ARHA_API_URL=http://localhost:8000
ARHA_SITE_URL=http://localhost:4321
ARHA_FILES_URL=http://localhost:8000/files
DATABASE_URL=postgresql+asyncpg://arha_app:arha_app@localhost:5432/arha
DATABASE_PLATFORM_URL=postgresql+asyncpg://arha_platform:arha_platform@localhost:5432/arha
DATABASE_MIGRATION_URL=postgresql+asyncpg://arha_owner:arha_owner@localhost:5432/arha
VALKEY_URL=redis://localhost:6379/0
COOKIE_SECURE=false
PAYMENT_PROVIDER_OVERRIDE=fake
# Production only, through SOPS: MASTER_KEY, TICKET_SIGNING_KEY, NOTCHPAY_*, CAMPAY_*, SMTP_*, GOOGLE_OAUTH_*
