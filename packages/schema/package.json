{
  "name": "@arha/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./form.schema.json": "./form.schema.json"
  },
  "scripts": {
    "generate": "json2ts -i form.schema.json -o src/form.ts --additionalProperties false --unreachableDefinitions",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  }
}
