   }
  },
  "variables": [],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "q_ok",
      "type": "yes_no",
      "label": {
       "fr": "Accord",
       "en": "Accord"
      },
      "required": true
     }
    ]
   },
   {
    "id": "p2",
    "blocks": [
     {
      "id": "q_name",
      "type": "short_text",
      "label": {
       "fr": "Nom",
       "en": "Nom"
      },
      "required": true
     }
    ]
   }
  ],
  "rules": [
   {
    "id": "r1",
    "when": {
     "field": "q_ok",
     "op": "eq",
     "value": false
    },
    "then": [
     {
      "action": "end_form"
     }
    ]
   }
  ]
 },
 "math": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": true,
    "currency": "XAF",
    "feeBearer": "org",
    "provider": "fake"
   }
  },
  "variables": [
   {
    "id": "ratio",
    "type": "number",
    "formula": {
     "op": "div",
     "args": [
      {
       "ref": "q_a"
      },
      {
       "ref": "q_b"
      }
     ]
    }
   },
   {
    "id": "rounded",
    "type": "number",
    "formula": {
     "op": "round",
     "args": [
      {
       "ref": "ratio"
      },
      {
       "num": 0
      }
     ]
    }
   },
   {
    "id": "count",
    "type": "number",
    "formula": {
     "op": "count_selected",
     "args": [
      {
       "ref": "q_tags"
      }
     ]
    }
   },
   {
    "id": "price",
    "type": "number",
    "formula": {
     "op": "add",
     "args": [
      {
       "ref": "q_a"
      },
      {
       "op": "mul",
       "args": [
        {
         "ref": "count"
        },
        {
         "num": 0.5
        }
       ]
      }
     ]
    }
   },
   {
    "id": "big",
    "type": "number",
    "formula": {
     "op": "max",
     "args": [
      {
       "ref": "q_a"
      },
      {
       "ref": "q_b"
      },
      {
       "num": 3
      }
     ]
    }
   },
   {
    "id": "small",
    "type": "number",
    "formula": {
     "op": "min",
     "args": [
      {
       "ref": "q_a"
      },
      {
       "ref": "q_b"
      }
     ]
    }
   },
   {
    "id": "diff",
    "type": "number",
    "formula": {
     "op": "sub",
     "args": [
      {
       "ref": "q_a"
      },
      {
       "ref": "q_b"
      },
      {
       "num": 1
      }
     ]
    }
   },
   {
    "id": "both",
    "type": "boolean",
    "formula": {
     "op": "and",
     "args": [
      {
       "op": "gt",
       "args": [
        {
         "ref": "q_a"
        },
        {
         "num": 0
        }
       ]
      },
      {
       "op": "not",
       "args": [
        {
         "op": "eq",
         "args": [
          {
           "ref": "q_b"
          },
          {
           "num": 0
          }
         ]
        }
       ]
      }
     ]
    }
   }
  ],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "q_a",
      "type": "number",
      "label": {
       "fr": "A",
       "en": "A"
      }
     },
     {
      "id": "q_b",
      "type": "number",
      "label": {
       "fr": "B",
       "en": "B"
      }
     },
     {
      "id": "q_tags",
      "type": "multi_choice",
      "label": {
       "fr": "Tags",
       "en": "Tags"
      },
      "options": [
       {
        "id": "x",
        "label": {
         "fr": "x",
         "en": "x"
        },
        "code": 1
       },
       {
        "id": "y",
        "label": {
         "fr": "y",
         "en": "y"
        },
        "code": 2
       },
       {
        "id": "z",
        "label": {
         "fr": "z",
         "en": "z"
        },
        "code": 3
       }
      ],
      "validation": {
       "maxSelected": 2
      }
     },
     {
      "id": "pay",
      "type": "payment_computed",
      "label": {
       "fr": "Paiement",
       "en": "Paiement"
      },
      "variable": "price"
     }
    ]
   }
  ],
  "rules": []
 },
 "operators": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": false,
    "currency": "XAF",
    "feeBearer": "org",
    "provider": "fake"
   }
  },
  "variables": [],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "q_txt",
      "type": "short_text",
      "label": {
       "fr": "Texte",
       "en": "Texte"
      }
     },
     {
      "id": "q_n",
      "type": "number",
      "label": {
       "fr": "N",
       "en": "N"
      }
     },
     {
      "id": "q_multi",
      "type": "multi_choice",
      "label": {
       "fr": "Multi",
       "en": "Multi"
      },
      "options": [
       {
        "id": "a",
        "label": {
         "fr": "a",
         "en": "a"
        },
        "code": 1
       },
       {
        "id": "b",
        "label": {
         "fr": "b",
         "en": "b"
        },
        "code": 2
       },
       {
        "id": "c",
        "label": {
         "fr": "c",
         "en": "c"
        },
        "code": 3
       }
      ]
     },
     {
      "id": "q_date",
      "type": "date",
      "label": {
       "fr": "Date",
       "en": "Date"
      }
     },
     {
      "id": "t_contains",
      "type": "short_text",
      "label": {
       "fr": "contains",
       "en": "contains"
      }
     },
     {
      "id": "t_not_contains",
      "type": "short_text",
      "label": {
       "fr": "not_contains",
       "en": "not_contains"
      }
     },
     {
      "id": "t_between",
      "type": "short_text",
      "label": {
       "fr": "between",
       "en": "between"
      }
     },
     {
      "id": "t_in",
      "type": "short_text",
      "label": {
       "fr": "in",
       "en": "in"
      }
     },
     {
      "id": "t_not_in",
      "type": "short_text",
      "label": {
       "fr": "not_in",
       "en": "not_in"
      }
     },
     {
      "id": "t_lt",
      "type": "short_text",
      "label": {
       "fr": "lt",
       "en": "lt"
      }
     },
     {
      "id": "t_lte",
      "type": "short_text",
      "label": {
       "fr": "lte",
       "en": "lte"
      }
     },
     {
      "id": "t_gt",
      "type": "short_text",
      "label": {
       "fr": "gt",
       "en": "gt"
      }
     },
     {
      "id": "t_neq",
      "type": "short_text",
      "label": {
       "fr": "neq",
       "en": "neq"
      }
     },
     {
      "id": "t_empty",
      "type": "short_text",
      "label": {
       "fr": "empty",
       "en": "empty"
      }
     },
     {
      "id": "t_date",
      "type": "short_text",
      "label": {
       "fr": "date",
       "en": "date"
      }
     },
     {
      "id": "t_multi",
      "type": "short_text",
      "label": {
       "fr": "multi",
       "en": "multi"
      }
     }
    ]
   }
  ],
  "rules": [
   {
    "id": "r1",
    "when": {
     "field": "q_txt",
     "op": "contains",
     "value": "arha"
    },
    "then": [
     {
      "action": "show",
      "target": "t_contains"
     }
    ]
   },
   {
    "id": "r2",
    "when": {
     "field": "q_txt",
     "op": "not_contains",
     "value": "arha"
    },
    "then": [
     {
      "action": "show",
      "target": "t_not_contains"
     }
    ]
   },
   {
    "id": "r3",
    "when": {
     "field": "q_n",
     "op": "between",
     "value": [
      10,
      20
     ]
    },
    "then": [
     {
      "action": "show",
      "target": "t_between"
     }
    ]
   },
   {
    "id": "r4",
    "when": {
     "field": "q_n",
     "op": "in",
     "value": [
      1,
      2,
      3
     ]
    },
    "then": [
     {
      "action": "show",
      "target": "t_in"
     }
    ]
   },
   {
    "id": "r5",
    "when": {
     "field": "q_n",
     "op": "not_in",
     "value": [
      1,
      2,
      3
     ]
    },
    "then": [
     {
      "action": "show",
      "target": "t_not_in"
     }
    ]
   },
   {
    "id": "r6",
    "when": {
     "field": "q_n",
     "op": "lt",
     "value": 5
    },
    "then": [
     {
      "action": "show",
      "target": "t_lt"
     }
    ]
   },
   {
    "id": "r7",
    "when": {
     "field": "q_n",
     "op": "lte",
     "value": 5
    },
    "then": [
     {
      "action": "show",
      "target": "t_lte"
     }
    ]
   },
   {
    "id": "r8",
    "when": {
     "field": "q_n",
     "op": "gt",
     "value": 5
    },
    "then": [
     {
      "action": "show",
      "target": "t_gt"
     }
    ]
   },
   {
    "id": "r9",
    "when": {
     "field": "q_txt",
     "op": "neq",
     "value": "x"
    },
    "then": [
     {
      "action": "show",
      "target": "t_neq"
     }
    ]
   },
   {
    "id": "r10",
    "when": {
     "field": "q_txt",
     "op": "empty"
    },
    "then": [
     {
      "action": "show",
      "target": "t_empty"
     }
    ]
   },
   {
    "id": "r11",
    "when": {
     "field": "q_date",
     "op": "gte",
     "value": "2027-03-02"
    },
    "then": [
     {
      "action": "show",
      "target": "t_date"
     }
    ]
   },
   {
    "id": "r12",
    "when": {
     "field": "q_multi",
     "op": "contains",
     "value": "b"
    },
    "then": [
     {
      "action": "show",
      "target": "t_multi"
     },
     {
      "action": "require",
      "target": "t_multi"
     }
    ]
   }
  ]
 },
 "setvar": {
  "schemaVersion": 1,
  "defaultLocale": "fr",
  "locales": [
   "fr",
   "en"
  ],
  "settings": {
   "payments": {
    "enabled": true,
    "currency": "XAF",
    "feeBearer": "org",
    "provider": "fake"
   }
  },
  "variables": [
   {
    "id": "price",
    "type": "number",
    "initial": 10000
   }
  ],
  "pages": [
   {
    "id": "p1",
    "blocks": [
     {
      "id": "q_type",
      "type": "dropdown",
      "label": {
       "fr": "Type",
       "en": "Type"
      },
      "options": [
       {
        "id": "std",
        "label": {
         "fr": "std",
         "en": "std"
        },
        "code": 1
       },
       {
        "id": "vip",
        "label": {
         "fr": "vip",
         "en": "vip"
        },
        "code": 2
       }
      ]
     },
     {
      "id": "q_n",
      "type": "number",
      "label": {
       "fr": "N",
       "en": "N"
      },
      "validation": {
       "integer": true,
       "min": 0
      }
     },
     {
      "id": "pay",
      "type": "payment_computed",
      "label": {
       "fr": "Paiement",
       "en": "Paiement"
      },
      "variable": "price"
     }
    ]
   }
  ],
  "rules": [
   {
    "id": "r1",
    "when": {
     "field": "q_type",
     "op": "eq",
     "value": "vip"
    },
    "then": [
     {
      "action": "set_variable",
      "target": "price",
      "value": {
       "op": "add",
       "args": [
        {
         "ref": "price"
        },
        {
         "op": "mul",
         "args": [
          {
           "ref": "q_n"
          },
          {
           "num": 2500.5
          }
         ]
        }
       ]
      }
     }
    ]
   }
  ]
 },
